@using Microsoft.AspNetCore.Identity
@using property_lease_saas.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser currentUser = null;
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Property Management SaaS</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Flex-based app shell: sidebar fixed width, main content flex-grow-1 -->
    <div class="app-shell d-flex min-vh-100">
        <!-- Sidebar -->
        @Html.Partial("_Sidebar")

        <!-- Main content area -->
        <div class="main-content flex-grow-1 d-flex flex-column">
            <!-- Topbar -->
            @Html.Partial("_Topbar")

            @if (currentUser != null)
            {
                <div id="signalRData" 
                     data-user-id="@currentUser.Id" 
                     data-user-type="@User.Claims.FirstOrDefault(c => c.Type == "UserType")?.Value"
                     data-user-name="@currentUser.FullName"
                     style="display:none;">
                </div>
            }

            <!-- Page content renders here using RenderBody() -->
            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Toast Container (for notifications) -->
    <div id="notificationToastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11"></div>

    <!-- jQuery (must come before SignalR) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap 5 JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js"></script>
    <script src="~/js/signalR-notifications.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>