@functions {
    private string GetStatusBadgeClass(MaintenanceRequestStatus status)
    {
        return status switch
        {
            MaintenanceRequestStatus.Requested => "bg-secondary",
            MaintenanceRequestStatus.Pending => "bg-secondary",
            MaintenanceRequestStatus.Published => "bg-info",
            MaintenanceRequestStatus.Assigned => "bg-warning text-dark",
            MaintenanceRequestStatus.InProgress => "bg-warning text-dark",
            MaintenanceRequestStatus.Completed => "bg-primary",
            MaintenanceRequestStatus.Verified => "bg-success",
            MaintenanceRequestStatus.Rejected => "bg-danger",
            _ => "bg-dark"
        };
    }
}

@section Scripts {
    <script>
        // Character counter
        document.getElementById('description')?.addEventListener('input', function() {
            document.getElementById('charCount').textContent = this.value.length;
        });

        // View Request Detail
        async function viewRequestDetail(requestId) {
            const modal = new bootstrap.Modal(document.getElementById('requestDetailModal'));
            modal.show();
            
            try {
                const response = await fetch(`/LandlordMaintenance/GetRequestDetail?id=${requestId}`);
                const html = await response.text();
                document.getElementById('requestDetailContent').innerHTML = html;
            } catch (error) {
                document.getElementById('requestDetailContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Error loading request details
                    </div>
                `;
            }
        }

        // View Application Detail
        async function viewApplicationDetail(applicationId, requestId) {
            const modal = new bootstrap.Modal(document.getElementById('applicationDetailModal'));
            modal.show();
            
            try {
                const response = await fetch(`/LandlordMaintenance/GetApplicationDetail?applicationId=${applicationId}&requestId=${requestId}`);
                const html = await response.text();
                document.getElementById('applicationDetailContent').innerHTML = html;
            } catch (error) {
                document.getElementById('applicationDetailContent').innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Error loading application details
                    </div>
                `;
            }
        }

        // Success/Error Toast Messages
        @if (TempData["Success"] != null)
        {
            <text>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["Success"]',
                timer: 3000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: '@TempData["Error"]',
                timer: 4000,
                showConfirmButton: true,
                toast: true,
                position: 'top-end'
            });
            </text>
        }
    </script>

    <!-- SweetAlert2 for better notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}