@model IEnumerable<property_lease_saas.Models.Entities.Lease>

<div class="container mt-4">
    <h2 class="mb-4">My Active Leases</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You don't have any active leases.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Property</th>
                        <th>Address</th>
                        <th>Rent</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Rent</th> 
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lease in Model)
                    {
                        <tr>
                            <td>@lease.Property?.Title</td>
                            <td>@lease.Property?.Address</td>
                            <td>Rs. @lease.RentAmount.ToString("N0")</td>
                            <td>@lease.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@lease.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-success">Active</span>
                            </td>
                            @* <td>
                                <form asp-controller="Payment" asp-action="MakeRentPayment" method="post">
                                        @Html.AntiForgeryToken()
                                    <input type="hidden" name="leaseId"  value="@lease.Id" />
                                    <button type="submit" class="btn btn-primary">Pay Rent</button>
                                </form>
                            </td> *@
                            <td> <span class="badge bg-success"><a asp-controller="Payment" asp-action="MakeRentPayment" asp-route-leaseId="@lease.Id.ToString()">Pay</a></span></td>
                            @* <td> <span class="badge bg-success"><    a href="Payment/MakeRentPayment/@lease.Id">Pay</a></span></td> *@

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Container for AJAX updates -->
<div id="leasesTableContainer"></div>