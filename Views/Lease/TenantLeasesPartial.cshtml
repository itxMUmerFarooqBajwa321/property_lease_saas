@model List<property_lease_saas.Models.Entities.Lease>

@if (!Model.Any())
{
    <div class="alert alert-info mb-0">
        No lease requests found
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Property</th>
                <th>Rent</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lease in Model)
            {
                <tr>
                    <td>@lease.Property?.Title</td>
                    <td>Rs. @lease.RentAmount</td>
                    <td>@lease.StartDate.ToString("MMM dd, yyyy")</td>
                    <td>@lease.EndDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (lease.Status == LeaseStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (lease.Status == LeaseStatus.Pending)
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@lease.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}