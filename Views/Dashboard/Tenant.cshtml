@{
    ViewData["Title"] = "Tenant Dashboard";
    
    var hasActiveLease = (bool)(ViewData["HasActiveLease"] ?? false);
    var activeLease = ViewData["ActiveLease"] as property_lease_saas.Models.Entities.Lease;
    var currentRent = (decimal)(ViewData["CurrentRent"] ?? 0);
    var daysUntilExpiry = (int)(ViewData["DaysUntilExpiry"] ?? 0);
    var leaseExpiringSoon = (bool)(ViewData["LeaseExpiringSoon"] ?? false);
    
    var totalLeaseRequests = (int)(ViewData["TotalLeaseRequests"] ?? 0);
    var pendingRequests = (int)(ViewData["PendingLeaseRequests"] ?? 0);
    var approvedRequests = (int)(ViewData["ApprovedRequests"] ?? 0);
    var rejectedRequests = (int)(ViewData["RejectedRequests"] ?? 0);
    
    var totalMaintenance = (int)(ViewData["TotalMaintenance"] ?? 0);
    var pendingMaintenance = (int)(ViewData["PendingMaintenance"] ?? 0);
    var inProgressMaintenance = (int)(ViewData["InProgressMaintenance"] ?? 0);
    var completedMaintenance = (int)(ViewData["CompletedMaintenance"] ?? 0);
    
    var recentLeaseRequests = ViewData["RecentLeaseRequests"] as List<property_lease_saas.Models.Entities.LeaseRequest> ?? new();
    var recentMaintenance = ViewData["RecentMaintenance"] as List<property_lease_saas.Models.Entities.MaintenanceRequest> ?? new();
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">
                <i class="bi bi-house-heart me-2"></i>Tenant Dashboard
            </h1>
            <p class="dashboard-subtitle">Welcome back, @ViewBag.UserName! Here's your rental overview</p>
        </div>
        <div class="dashboard-actions">
            @if (!hasActiveLease)
            {
                <a href="/Properties/Index" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Find Properties
                </a>
            }
            else
            {
                <a href="/TenantMaintenance/Create" class="btn btn-primary">
                    <i class="bi bi-tools me-2"></i>Request Maintenance
                </a>
            }
        </div>
    </div>

    <!-- Active Lease Card (if exists) -->
    @if (hasActiveLease && activeLease != null)
    {
        <div class="lease-details-card">
            <h3><i class="bi bi-house-check me-2"></i>Active Lease</h3>
            <div class="lease-detail-row">
                <span class="lease-detail-label">Property</span>
                <span class="lease-detail-value">@activeLease.Property?.Title</span>
            </div>
            <div class="lease-detail-row">
                <span class="lease-detail-label">Monthly Rent</span>
                <span class="lease-detail-value">Rs. @currentRent.ToString("N0")</span>
            </div>
            <div class="lease-detail-row">
                <span class="lease-detail-label">Lease Period</span>
                <span class="lease-detail-value">
                    @activeLease.StartDate.ToString("MMM dd, yyyy") - @activeLease.EndDate.ToString("MMM dd, yyyy")
                </span>
            </div>
            <div class="lease-detail-row">
                <span class="lease-detail-label">Days Until Expiry</span>
                <span class="lease-detail-value">@daysUntilExpiry days</span>
            </div>
            @if (leaseExpiringSoon)
            {
                <div class="alert alert-warning mt-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Your lease is expiring soon! Consider renewing or finding a new property.
                </div>
            }
        </div>
    }

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card stat-card-primary">
            <div class="stat-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Lease Requests</div>
                <div class="stat-value">@totalLeaseRequests</div>
                <div class="stat-change">
                    <i class="bi bi-clock"></i> @pendingRequests pending
                </div>
            </div>
        </div>

        <div class="stat-card stat-card-success">
            <div class="stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Approved Requests</div>
                <div class="stat-value">@approvedRequests</div>
                <div class="stat-change positive">
                    <i class="bi bi-arrow-up"></i> @rejectedRequests rejected
                </div>
            </div>
        </div>

        <div class="stat-card stat-card-warning">
            <div class="stat-icon">
                <i class="bi bi-tools"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Maintenance Requests</div>
                <div class="stat-value">@totalMaintenance</div>
                <div class="stat-change">
                    <i class="bi bi-gear"></i> @inProgressMaintenance in progress
                </div>
            </div>
        </div>

        <div class="stat-card stat-card-info">
            <div class="stat-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Monthly Rent</div>
                <div class="stat-value">Rs. @currentRent.ToString("N0")</div>
                <div class="stat-change">
                    @if (hasActiveLease)
                    {
                        <i class="bi bi-calendar-check"></i>
                        <span>Active lease</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle"></i>
                        <span>No active lease</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="content-grid">
        <!-- Left Column -->
        <div class="content-column-left">
            <!-- Recent Lease Requests -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-file-earmark-text me-2"></i>My Lease Requests
                    </h3>
                    <a href="/Lease/MyRequests" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (!recentLeaseRequests.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>No lease requests yet</p>
                            <a href="/Properties/Index" class="btn btn-primary mt-3">
                                <i class="bi bi-search me-2"></i>Browse Properties
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var request in recentLeaseRequests)
                            {
                                <div class="list-item">
                                    <div class="list-item-icon bg-primary-subtle">
                                        <i class="bi bi-house-door text-primary"></i>
                                    </div>
                                    <div class="list-item-content">
                                        <div class="list-item-title">@request.Property?.Title</div>
                                        <div class="list-item-subtitle">
                                            Requested @request.RequestedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div class="list-item-action">
                                        <span class="badge @GetStatusBadgeClass(request.Status)">
                                            @request.Status
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Maintenance -->
            <div class="dashboard-card mt-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-tools me-2"></i>My Maintenance Requests
                    </h3>
                    <a href="/TenantMaintenance/Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (!recentMaintenance.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>No maintenance requests</p>
                            @if (hasActiveLease)
                            {
                                <a href="/TenantMaintenance/Create" class="btn btn-primary mt-3">
                                    <i class="bi bi-plus-circle me-2"></i>Create Request
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var maintenance in recentMaintenance)
                            {
                                <div class="list-item">
                                    <div class="list-item-icon @GetMaintenanceIconClass(maintenance.Status)">
                                        <i class="bi @GetMaintenanceIcon(maintenance.Status)"></i>
                                    </div>
                                    <div class="list-item-content">
                                        <div class="list-item-title">@maintenance.Title</div>
                                        <div class="list-item-subtitle">
                                            Created @maintenance.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div class="list-item-action">
                                        <span class="badge @GetMaintenanceStatusBadge(maintenance.Status)">
                                            @maintenance.Status
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="content-column-right">
            <!-- Quick Actions -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightning-charge me-2"></i>Quick Actions
                    </h3>
                </div>
                <div class="card-body">
                    <div class="quick-actions-grid">
                        @if (hasActiveLease)
                        {
                            <a href="/TenantMaintenance/Create" class="quick-action-btn">
                                <i class="bi bi-tools"></i>
                                <span>Request Repair</span>
                            </a>
                            <a href="/Lease/MyRequests" class="quick-action-btn">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>My Requests</span>
                            </a>
                        }
                        else
                        {
                            <a href="/Properties/Index" class="quick-action-btn">
                                <i class="bi bi-search"></i>
                                <span>Find Property</span>
                            </a>
                            <a href="/Lease/MyRequests" class="quick-action-btn">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>My Requests</span>
                            </a>
                        }
                        <a href="/TenantMaintenance/Index" class="quick-action-btn">
                            <i class="bi bi-list-check"></i>
                            <span>Maintenance History</span>
                        </a>
                        <a href="/Account/Profile" class="quick-action-btn">
                            <i class="bi bi-person"></i>
                            <span>My Profile</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Status Summary -->
            <div class="dashboard-card mt-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-bar-chart me-2"></i>Status Summary
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Lease Requests Progress -->
                    <div class="progress-container">
                        <div class="progress-label">
                            <span>Lease Requests</span>
                            <span>@approvedRequests/@totalLeaseRequests approved</span>
                        </div>
                        <div class="progress-bar-wrapper">
                            <div class="progress-bar" style="width: @(totalLeaseRequests > 0 ? (approvedRequests * 100.0 / totalLeaseRequests) : 0)%"></div>
                        </div>
                    </div>

                    <!-- Maintenance Progress -->
                    <div class="progress-container mt-3">
                        <div class="progress-label">
                            <span>Maintenance Requests</span>
                            <span>@completedMaintenance/@totalMaintenance completed</span>
                        </div>
                        <div class="progress-bar-wrapper">
                            <div class="progress-bar" style="width: @(totalMaintenance > 0 ? (completedMaintenance * 100.0 / totalMaintenance) : 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications -->
            <div class="dashboard-card mt-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-bell me-2"></i>Notifications
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert-list">
                        @if (!hasActiveLease)
                        {
                            <div class="alert-item alert-warning">
                                <i class="bi bi-house-slash"></i>
                                <div>
                                    <strong>No Active Lease</strong>
                                    <p>Browse available properties to find your new home</p>
                                </div>
                            </div>
                        }
                        else if (leaseExpiringSoon)
                        {
                            <div class="alert-item alert-danger">
                                <i class="bi bi-calendar-x"></i>
                                <div>
                                    <strong>Lease Expiring Soon!</strong>
                                    <p>Your lease expires in @daysUntilExpiry days</p>
                                </div>
                            </div>
                        }

                        @if (pendingMaintenance > 0)
                        {
                            <div class="alert-item alert-info">
                                <i class="bi bi-tools"></i>
                                <div>
                                    <strong>@pendingMaintenance Pending Maintenance</strong>
                                    <p>Waiting for landlord approval</p>
                                </div>
                            </div>
                        }

                        @if (pendingRequests > 0)
                        {
                            <div class="alert-item alert-secondary">
                                <i class="bi bi-clock"></i>
                                <div>
                                    <strong>@pendingRequests Pending Request(s)</strong>
                                    <p>Awaiting landlord response</p>
                                </div>
                            </div>
                        }

                        @if (!hasActiveLease && pendingRequests == 0 && pendingMaintenance == 0)
                        {
                            <div class="empty-state">
                                <i class="bi bi-check-circle text-success"></i>
                                <p>All caught up!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(property_lease_saas.Models.Entities.LeaseRequestStatus status)
    {
        return status switch
        {
            property_lease_saas.Models.Entities.LeaseRequestStatus.Pending => "badge-warning",
            property_lease_saas.Models.Entities.LeaseRequestStatus.Approved => "badge-success",
            property_lease_saas.Models.Entities.LeaseRequestStatus.Rejected => "badge-danger",
            _ => "badge-secondary"
        };
    }

    private string GetMaintenanceIcon(property_lease_saas.Models.Entities.MaintenanceRequestStatus status)
    {
        return status switch
        {
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Requested => "bi-hourglass-split",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Published => "bi-megaphone",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Assigned => "bi-person-check",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.InProgress => "bi-gear",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Completed => "bi-check-circle",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Verified => "bi-patch-check",
            _ => "bi-question-circle"
        };
    }

    private string GetMaintenanceIconClass(property_lease_saas.Models.Entities.MaintenanceRequestStatus status)
    {
        return status switch
        {
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Requested => "bg-warning-subtle",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Published => "bg-info-subtle",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.InProgress => "bg-primary-subtle",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Verified => "bg-success-subtle",
            _ => "bg-secondary"
        };
    }

    private string GetMaintenanceStatusBadge(property_lease_saas.Models.Entities.MaintenanceRequestStatus status)
    {
        return status switch
        {
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Requested => "badge-warning",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Published => "badge-info",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.InProgress => "badge-primary",
            property_lease_saas.Models.Entities.MaintenanceRequestStatus.Verified => "badge-success",
            _ => "badge-secondary"
        };
    }
}