@model property_lease_saas.Models.Entities.RentPayment
@{
    ViewData["Title"] = "Make Rent Payment";
    var lease = ViewBag.Lease as property_lease_saas.Models.Entities.Lease;
}

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">
                <i class="bi bi-credit-card me-2"></i>Make Rent Payment
            </h1>
            <p class="dashboard-subtitle">Submit your monthly rent payment</p>
        </div>
        <div class="dashboard-actions">
            <a href="/Payment/MyRentPayments" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="dashboard-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-cash-stack me-2"></i>Payment Details
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="MakeRentPayment" method="post">
                        <input type="hidden" asp-for="LeaseId" value="@lease?.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Property</label>
                            <p class="form-control-static">@lease?.Property?.Title</p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Rent Amount</label>
                            <p class="form-control-static">
                                <span class="h4 text-primary">Rs. @lease?.RentAmount.ToString("N0")</span>
                            </p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PaymentFor" class="form-label">Payment For (Month/Year)</label>
                            <input asp-for="PaymentFor" class="form-control" placeholder="e.g., January 2024" required />
                            <span asp-validation-for="PaymentFor" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DueDate" class="form-label">Due Date</label>
                            <input asp-for="DueDate" type="date" class="form-control" required />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select" required>
                                <option value="">Select Payment Method</option>
                                <option value="Cash">Cash</option>
                                <option value="BankTransfer">Bank Transfer</option>
                                <option value="Card">Credit/Debit Card</option>
                                <option value="MobileMoney">Mobile Money (JazzCash/EasyPaisa)</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TransactionId" class="form-label">Transaction ID / Reference Number</label>
                            <input asp-for="TransactionId" class="form-control" placeholder="Enter transaction reference" />
                            <small class="form-text text-muted">If applicable (bank transfer, online payment, etc.)</small>
                            <span asp-validation-for="TransactionId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional notes"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Payment Notice:</strong> Your payment will be marked as "Pending" until the landlord confirms receipt. 
                            Late payments may incur a 5% late fee.
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Submit Payment
                            </button>
                            <a href="/Payment/MyRentPayments" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Lease Summary -->
            <div class="dashboard-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-file-text me-2"></i>Lease Summary
                    </h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">Property</label>
                        <p class="mb-0 fw-bold">@lease?.Property?.Title</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Landlord</label>
                        <p class="mb-0">@lease?.Property?.LandlordId</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Monthly Rent</label>
                        <p class="mb-0 h5 text-primary">Rs. @lease?.RentAmount.ToString("N0")</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Lease Period</label>
                        <p class="mb-0">
                            @lease?.StartDate.ToString("MMM dd, yyyy") <br />
                            to @lease?.EndDate.ToString("MMM dd, yyyy")
                        </p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Status</label>
                        <p class="mb-0">
                            <span class="badge badge-success">@lease?.Status</span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Payment Tips -->
            <div class="dashboard-card mt-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-lightbulb me-2"></i>Payment Tips
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Pay on time to avoid late fees
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Keep transaction receipts
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Provide accurate reference numbers
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-2"></i>
                            Contact landlord for payment confirmation
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}